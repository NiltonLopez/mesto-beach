# ─── Backend ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=mestobeach;Username=mestobeach;Password=mestobeach_dev
ConnectionStrings__Redis=localhost:6379,password=mestobeach_dev
ConnectionStrings__MongoDB=mongodb://mestobeach:mestobeach_dev@localhost:27017/mestobeach_catalog?authSource=admin

# JWT RS256: en Development la API genera una clave local y puedes borrar estas dos líneas.
# Cualquier otro entorno las exige. Genera las tuyas con:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
Jwt__PrivateKeyPem=REPLACE_WITH_PRIVATE_KEY_PEM
Jwt__PublicKeyPem=REPLACE_WITH_PUBLIC_KEY_PEM

# TOTP — generate with:
#   openssl rand -hex 32
Totp__EncryptionKeyHex=REPLACE_WITH_32_BYTE_HEX

# Google OAuth
Google__ClientId=REPLACE_WITH_GOOGLE_CLIENT_ID

# Frontend URL (for email links)
Frontend__BaseUrl=http://localhost:3000

# Email (MailHog for dev)
Email__Host=localhost
Email__Port=1025
Email__FromAddress=noreply@mestobeach.local
Email__FromName=Mesto Beach

# ─── Frontend env vars ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5011
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
